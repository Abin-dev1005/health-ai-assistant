 src="https://images.eu.ctfassets.net/e2agrqk9adjs/2WlmUFlcNJx2MUNlXs0Dhp/7f1bf18fb80eabeac8db8ef2c1c53e2b/Heartbeat-Off-White-RGB.png?w=512&amp;h=512&amp;fit=fill&amp;f=center&amp;q=80&amp;fm=webp"/></div></div><div class="cta-content relative w-full p-4 mx-auto left-1/2 -translate-x-1/2 justify-center items-center flex flex-col text-center"><span data-contentful-field-id="heading" class="block font-bold mb-2 text-3xl/[115%] text-contrast-five">180,381</span><p data-contentful-field-id="text" class="text-base mb-2 text-contrast-five">people were taught lifesaving skills</p><div class="flex flex-row gap-2 flex-wrap text-center justify-center"></div></div></div></div></div><div class="content-lister-grid-item shrink-0 rounded-sm lg:w-[calc(33.333%-1rem)]"><div data-contentful-entry-id="u4YHT0O48wd5btoS9JRA2" class="cta-icon cta-wrapper @container relative block w-full h-full rounded-lg overflow-hidden group transition-all duration-300 bg-primary-dark"><div class="cta-container"><div class="cta-image cta-icon-media"><div class="relative aspect-square object-contain size-25 mx-auto"><img alt="A simple illustration in bright green of a clock." width="100" height="100" decoding="async" data-nimg="1" class="w-full h-full object-cover" style="color:transparent" src="https://images.eu.ctfassets.net/e2agrqk9adjs/6p2oCQ5Jpp8adVUKoomk9W/bbf2309ef4e35e2f0bf19bacae0de556/Time-Bright-Green-RGB.svg?w=100&amp;h=100&amp;fit=fill&amp;f=center&amp;q=80&amp;fm=webp"/></div></div><div class="cta-content relative w-full p-4 mx-auto left-1/2 -translate-x-1/2 justify-center items-center flex flex-col text-center"><span data-contentful-field-id="heading" class="block font-bold mb-2 text-3xl/[115%] text-off-white">458,000</span><p data-contentful-field-id="text" class="text-base mb-2 text-off-white">hours were given by our dedicated volunteers</p><div class="flex flex-row gap-2 flex-wrap text-center justify-center"></div></div></div></div></div></div></div></div></div></div></section></div><div><section data-contentful-entry-id="4HZrCOyqOWxzBs10KH6Cag" class="flex flex-col md:flex-row overflow-hidden rounded-lg"><div class="bg-primary-dark text-off-white justify-center w-full md:w-[50%] flex flex-col items-flex-start px-4 py-6 md:p-10 flex-1"><h2 class="text-inherit text-lg/snug lg:text-2xl/tight font-bold mb-3">Children and young people</h2><div data-contentful-field-id="text" class="prose prose-lg text-sm/tight lg:text-base/snug [&amp;_a]:text-inherit! [&amp;_a:hover]:text-inherit! [&amp;_a:active]:text-inherit! [&amp;_a:focus-visible]:text-inherit!"><div class="rich-text-content [&amp;&gt;*:last-child]:mb-0"><p class="mb-4 last:mb-0">Join the next generation of lifesavers! Our youth programmes teach 5-25 year olds real life skills within a fun, supportive community. </p></div></div><div data-contentful-field-id="links" class="mt-6 flex gap-4 justify-start items-center flex-wrap flex-row"><a data-contentful-entry-id="6HGmlA4fOt7rj6oMn8l0G9" href="/get-involved/young-people/" class="inline-flex items-center gap-2 focus-visible:bg-secondary focus-visible:outline-2 focus-visible:outline-primary focus-visible:text-contrast-five focus-visible:outline-offset-0 font-bold text-contrast-five tracking-wide font-body disabled:!bg-contrast-three disabled:!outline-none border-2 has-[svg]:h-auto transition-[background-color,border-color,color,transform] motion-safe:duration-200 motion-safe:ease-out motion-safe:[transform:translateZ(0)] [-webkit-font-smoothing:antialiased] [backface-visibility:hidden] motion-reduce:transform-none cursor-pointer disabled:!border-contrast-three bg-primary border-primary hover:bg-bright-green rounded-[360px] hover:border-bright-green active:bg-secondary [&amp;_svg,&amp;_img]:-order-1 h-12 px-3 text-base [&amp;_svg]:!size-6 has-[svg]:min-h-12 motion-safe:hover:scale-[1.05] motion-safe:focus-visible:scale-[1.05] motion-safe:active:scale-[1.02]"><span class="shrink-0 no-underline"><svg width="15" height="15" viewBox="0 0 15 15" fill="non